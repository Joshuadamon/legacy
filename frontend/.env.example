# Local play. A production web export must set this to the public API origin, with no /api suffix, before `npx expo export`.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001
# Stripe keys stay on the API host. Do not put them in this file.
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=
