MONGO_URL=mongodb://localhost:27017
DB_NAME=legacy
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
MODEL_PROVIDER=anthropic
MODEL_NAME=
LEGACY_SEASON_LIMIT=60
# Leave unset. A new profile starts at 250 marks.
# LEGACY_STARTING_MARKS=
# Set to 0 to refuse the local test-purchase stub. Default in code is 1.
LEGACY_TEST_PURCHASES=1
PORT=8001
# Test mode only. Real values stay on the API host and are never committed.
# The static web build does not receive these.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
